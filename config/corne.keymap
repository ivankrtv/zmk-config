#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        fourlayout {
            bindings = <&to 3>;
            key-positions = <38 39>;
        };

        x {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <10 9>;
        };

        e {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <21 22>;
        };

        opp {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <5 4>;
        };

        clsp {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 6>;
        };

        lftbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 17>;
        };

        rghtbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 19>;
        };

        opnsqrt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 29>;
        };

        rghtsqrt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &kp Q  &kp W  &kp E                 &kp R             &kp T          &kp Y      &kp U           &kp I             &kp O    &kp P     &none
&none  &kp A  &kp S  &kp D                 &kp F             &kp G          &kp H      &kp J           &kp K             &kp L    &kp SEMI  &none
&none  &kp Z  &kp X  &kp C                 &kp V             &kp B          &kp N      &kp M           &kp COMMA         &kp DOT  &kp FSLH  &none
                     &mt LEFT_CONTROL TAB  &kp LEFT_COMMAND  &lt 2 SPACE    &lt 1 RET  &mt RSHFT BSPC  &mt LEFT_ALT ESC
            >;
        };

        layer_1 {
            bindings = <
&none  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4      &kp NUMBER_5            &kp NUMBER_6          &kp NUMBER_7           &kp NUMBER_8      &kp NUMBER_9     &kp N0            &none
&none  &kp EXCLAMATION  &kp AT_SIGN   &kp AMPERSAND     &kp MINUS         &kp EQUAL               &kp LEFT_ARROW        &kp DOWN_ARROW         &kp UP_ARROW      &kp RIGHT_ARROW  &kp SINGLE_QUOTE  &none
&none  &kp DOLLAR       &kp PERCENT   &kp GRAVE         &kp LEFT_BRACKET  &kp RIGHT_BRACKET       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp FSLH          &none
                                      &mt LEFT_ALT TAB  &kp LEFT_COMMAND  &mt LEFT_SHIFT SPACE    &lt 1 RET             &mt RSHFT BSPC         &mt LEFT_ALT ESC
            >;
        };

        layer_2 {
            bindings = <
&none  &kp ESCAPE                            &none  &kp PAGE_UP           &kp C_NEXT        &kp C_VOLUME_UP      &kp C_BRI_UP          &kp F1      &kp F2        &kp F3   &kp F4   &none
&none  &none                                 &none  &kp HOME              &kp C_PLAY_PAUSE  &kp K_MUTE           &kp COLON             &kp F5      &kp F6        &kp F7   &kp F8   &none
&none  &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &none  &kp PAGE_DOWN         &kp C_PREVIOUS    &kp C_VOLUME_DOWN    &kp C_BRIGHTNESS_DEC  &kp F9      &kp F10       &kp F11  &kp F12  &none
                                                    &mt LEFT_CONTROL TAB  &kp LEFT_COMMAND  &lt 2 SPACE          &kp KP_COMMA          &kp KP_DOT  &kp QUESTION
            >;
        };

        layer_3 {
            bindings = <
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&none   &bt BT_CLR      &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &none           &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
